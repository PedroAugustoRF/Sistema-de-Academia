{
  "name": "gymcontrol",
  "version": "1.0.0",
  "private": true,
  "description": "GymControl — frontend estático e API REST Express/MySQL",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "nodemon --watch backend/src --watch backend/.env backend/src/application/server.js",
    "start": "node backend/src/application/server.js",
    "test": "node --test backend/test/app.test.js",
    "check": "node backend/scripts/check-syntax.js",
    "check:db": "node backend/scripts/check-database.js"
  },
  "engines": {
    "node": ">=20.6.0",
    "npm": ">=9.0.0"
  }
}
